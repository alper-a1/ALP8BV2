// ALP8BV2 — Tang Nano 9K pin constraints (.cst)
// Pin numbers are the GW1NR QFN88 ball numbers, NOT header names.
// Reference: Sipeed Tang Nano 9K schematic / led sample (same numbers).
// NOTE: PSRAM shares pins with some user IO on this board — check the schematic
// before assigning anything new if PSRAM enters the design.

// --- system ------------------------------------------------------------------
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "k1" 4;              // user button K1 (pressed -> low)
IO_PORT "k1" PULL_MODE=UP;

IO_LOC "k2" 3;               // user button K2 (pressed -> low)
IO_PORT "k2" PULL_MODE=UP;

// --- user LEDs: 6 total (pin numbers from Sipeed's own led sample) ------------
// LED0..LED3 -> Grove header sockets 1-4: they share pins with the LED5/6
// header + I2C, so driving LED0..3 while something is plugged in those sockets
// needs a schematic check. LED4/LED5 (pins 15/16) are the safe standalone pair.
IO_LOC "led[0]" 10;
IO_LOC "led[1]" 11;
IO_LOC "led[2]" 13;
IO_LOC "led[3]" 14;
IO_LOC "led[4]" 15;
IO_LOC "led[5]" 16;
IO_PORT "led[0]" PULL_MODE=UP DRIVE=8;
IO_PORT "led[1]" PULL_MODE=UP DRIVE=8;
IO_PORT "led[2]" PULL_MODE=UP DRIVE=8;
IO_PORT "led[3]" PULL_MODE=UP DRIVE=8;
IO_PORT "led[4]" PULL_MODE=UP DRIVE=8;
IO_PORT "led[5]" PULL_MODE=UP DRIVE=8;

// --- HDMI (TMDS) pairs: 3 data + 1 clock, differential                       --
// (unused in M0; declared for M2 when the video pipeline lands. p/n order matters!)
// IO_LOC "tmds_clk_p" 69,68;
// IO_LOC "tmds_d_p[0]" 71,70;
// IO_LOC "tmds_d_p[1]" 73,72;
// IO_LOC "tmds_d_p[2]" 75,74;
// IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8;
// IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8;
// IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8;
// IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8;
