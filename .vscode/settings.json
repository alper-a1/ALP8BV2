{
    "verilog.linting.linter": "verilator",
    // super annoying; need to list every directory for linting.
    "verilog.linting.verilator.arguments": "-Wall -sv -y src/cu -y src/dp -y src/dp/alu",
    // --- C++ Settings ---
    "[cpp]": {
        // Explicitly tell VS Code to use clangd for C++
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    // --- Verilog / SystemVerilog Settings ---
    "[verilog]": {
        // Tell VS Code to use the mshr-h extension for Verilog
        "editor.defaultFormatter": "mshr-h.veriloghdl"
    },
    "[systemverilog]": {
        "editor.defaultFormatter": "mshr-h.veriloghdl"
    },
}